// Configurazione del sito viviascoli.com su Cloudflare.
// Non va modificato: Cloudflare lo legge a ogni caricamento su GitHub.
{
  "name": "viviascoli",
  "compatibility_date": "2026-09-23",
  "main": "_cloudflare/worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // "none" = gli indirizzi restano .html, identici a oggi (niente redirect)
    "html_handling": "none"
  },
  "workers_dev": true
}
